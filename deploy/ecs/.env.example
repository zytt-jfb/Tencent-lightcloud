# ===== 阿里云 ECS 部署环境变量示例 =====
# 复制本文件为同目录 .env 后填入真实值（.env 切勿提交到 Git）。

# 数据持久化根目录：建议挂载到 ECS 数据盘，例如 /data
DATA_ROOT=/data/biz-reporting

# 前端容器对外端口（ECS 安全组需放行；生产建议前置 SLB/443）
HTTP_PORT=80

# 已备案的公网域名（用于 CORS 与小程序 request 合法域名）
DOMAIN=example.com

# ===== CI 构建模式（可选）=====
# 镜像由 CI 构建并推送到私有仓库后，部署时提供完整镜像地址并追加 --pull-only，
# 服务器即可跳过本机构建（这台 2C/2G 主机本机构建一次要 9~27 分钟）：
#   API_IMAGE=ccr.ccs.tencentyun.com/<命名空间>/biz-reporting-api:<commit>
#   WEB_IMAGE=ccr.ccs.tencentyun.com/<命名空间>/biz-reporting-frontend:<commit>
# 不设置这两项时，compose 沿用本机构建的镜像名，行为与原来一致。
# API_IMAGE=
# WEB_IMAGE=

# 数据库：新建独立库，勿复用 CloudBase 凭据
DB_DATABASE=biz_reporting
DB_USERNAME=biz_runtime
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
DB_POOL_CONNECTION_LIMIT=8
DB_POOL_QUEUE_LIMIT=100
DB_LOGGING=false

# JWT / 鉴权密钥：各自独立随机生成（≥32 字符），切勿使用示例值
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_SECURITY_HMAC_KEY=replace-with-a-different-at-least-32-random-characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=biz-reporting-api
JWT_AUDIENCE=biz-reporting-clients

# 微信登录（可选；需要小程序登录时再填）
WECHAT_APPID=
WECHAT_SECRET=
