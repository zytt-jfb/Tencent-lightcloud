[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = +08:00
skip-name-resolve
max_connections = 60

# 缓冲池：biz_order_rows 约 1.2GB，容器内存上限 768m。
# 缓冲池固定 512M，其余留给连接/排序/临时表；此前容器上限 512m 被顶满（实测 98.9%）导致频繁换页。
innodb_buffer_pool_size = 512M

innodb_flush_log_at_trx_commit = 1
sync_binlog = 1

# 慢查询观测：历史上曾出现单条查询 25~42 秒却长期无人发现（slow_query_log 关闭、阈值 10s）。
# 阈值降到 1s；日志写在数据卷内，容器重建不丢失。长期运行需定期 FLUSH SLOW LOGS 或清理。
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow-query.log
long_query_time = 1
log_queries_not_using_indexes = 0

[client]
default-character-set = utf8mb4
