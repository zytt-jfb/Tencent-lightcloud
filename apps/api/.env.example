# ============================================================
# 经营单元上报系统 - API 环境配置
# 复制此文件为 .env.local 并修改实际值
# ============================================================

# 服务端口
PORT=3000
NODE_ENV=development
DEPLOY_ENV=local

# ---- MySQL 数据库 ----
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=biz_reporting
DB_POOL_CONNECTION_LIMIT=10
DB_POOL_QUEUE_LIMIT=0
DB_SYNC=false          # 生产环境务必 false，用 migration
DB_LOGGING=true         # 开发环境开启 SQL 日志

# ---- 上传解析临时目录（通常留空，使用系统临时目录）----
# 仅测试或排障时覆盖，必须为绝对路径；原始 Excel 不作为长期持久化资产。
FACT_SOURCE_STORAGE_ROOT=

# ---- JWT 认证 ----
# 必填。使用密钥管理服务注入随机值；缺失或仅含空白时 API 拒绝启动。
JWT_SECRET=
JWT_EXPIRES_IN=8h
# 签发与验证共用的 issuer/audience（生产必填，禁止为空）
JWT_ISSUER=biz-reporting-api
JWT_AUDIENCE=biz-reporting-clients

# ---- 登录安全 ----
# 独立密钥，用于登录哈希桶与审计事件 HMAC；必填且禁止等于 JWT_SECRET
AUTH_SECURITY_HMAC_KEY=
# IP 级限流与账号锁定窗口（生产必填）
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_IP_MAX=5
AUTH_ACCOUNT_WINDOW_MS=900000
AUTH_ACCOUNT_MAX_FAILURES=5
AUTH_ACCOUNT_BLOCK_MS=900000

# ---- 可信代理（生产必填，只接受 1-3 的整数）----
TRUST_PROXY_HOPS=1

# ---- readiness 探针 ----
# 结果缓存与依赖探测超时（生产必填）
READINESS_CACHE_MS=5000
READINESS_TIMEOUT_MS=2000

# ---- 微信小程序（TODO）----
WECHAT_APPID=
WECHAT_SECRET=

# ---- CORS ----
# production 必填；仅允许逗号分隔的完整 HTTPS origin，禁止 *、localhost 和路径
CORS_ORIGINS=https://your-admin-web-domain.com,https://your-miniprogram-domain.com

# ---- 对象存储（当前事实导入使用上面的受控本地存储）----
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# ============================================================
# 内部 AI 助手（查数 / 报告 / 问答）—— 全部为「可选」配置
# 说明：任何一项缺失都不会导致 API 启动失败，只会让 AI 接口返回未配置提示。
#       本模块默认不连接任何大模型：ENABLE_LLM=false 时代码里没有真实模型对象。
# ============================================================

# 总开关：false 时 AI 相关路由仍注册，但只读数据源/大模型都不启用（返回 503 提示）
AI_ENABLED=true

# 大模型开关（默认禁用；改为 true 需重过隐私评审 + 验收）
ENABLE_LLM=false
LLM_PROVIDER=local-ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 云 API 密钥留空即为不启用；即使填了，也要 AI_CLOUD_ALLOW=true 才会初始化
LLM_API_KEY=
AI_CLOUD_ALLOW=false
LLM_TIMEOUT_MS=120000

# 只读 MySQL（独立账号，仅 GRANT SELECT 到业务白名单表）
# 格式：mysql://用户名:密码@主机:3306/库名   密码含特殊字符需 URL 编码
READONLY_DSN=

# 本地 sqlite（RAG 片段 + 数据飞轮 + 反馈共用）
AI_SQLITE_PATH=./data/ai/ai.sqlite
# 向量后端落盘目录（当前 lexical 检索暂不使用，为切换 sqlite-vec 预留）
VECTOR_PATH=./data/ai/vectors

# 并发与结果规模（2C2G：并发 1~2，单次最多 500 行）
MAX_CONCURRENCY=2
AI_MAX_ROWS=500
AI_RAG_TOP_K=5


