{
  "name": "biz-reporting-system",
  "version": "0.1.0",
  "private": true,
  "description": "经营单元上报系统 - Monorepo",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:admin": "pnpm --filter admin-web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @biz-reporting/shared-types build && pnpm -r typecheck",
    "db:migrate:precheck": "node scripts/db/migrate.mjs precheck",
    "db:migrate:status": "node scripts/db/migrate.mjs status",
    "db:migrate": "node scripts/db/migrate.mjs up",
    "migration-files:check": "node scripts/db/migrate.mjs check-files",
    "auth:promote-root": "node scripts/auth/promote-root.mjs",
    "auth:root-readiness": "node scripts/auth/promote-root.mjs --check",
    "test:migrations:mysql": "node scripts/test/run-migrations-mysql.mjs",
    "test:facts-v31": "pnpm --filter @biz-reporting/shared-types build && pnpm --filter @biz-reporting/api build && node scripts/test/run-facts-v31.mjs",
    "test:auth-v3": "pnpm --filter @biz-reporting/shared-types build && pnpm --filter @biz-reporting/api build && node scripts/test/run-auth-v3.mjs",
    "test:exports-v3": "node scripts/test/run-page-exports.mjs",
    "test:metric-sources": "pnpm --filter @biz-reporting/shared-types build && node scripts/test/run-metric-source-contract.mjs",
    "test:rbac-auth-export-settings": "pnpm test:auth-v3 && pnpm --filter @biz-reporting/admin-web build && pnpm test:exports-v3 && pnpm test:metric-sources",
    "test:storage-gate": "pnpm --filter @biz-reporting/api build && node scripts/test/check-fact-storage-gate.mjs",
    "test:deployment-preflight": "node scripts/test/check-production-runtime-config.mjs && node scripts/test/run-deployment-preflight.mjs",
    "test:unit": "node scripts/test/run-unit.mjs",
    "test:i1:mysql:concurrency": "pnpm --filter @biz-reporting/api build && node apps/api/test/import-job-concurrency.mysql.i1.mjs",
    "test:i1:mysql:migrations": "node scripts/test/run-migrations-mysql.mjs",
    "test:i1:tokens:dual-chain": "node apps/api/test/dual-chain-verify.mjs",
    "test:i1:tokens:real-write": "node apps/api/test/real-write-verify.mjs",
    "test:i1:tokens:import-loop": "node apps/api/test/import-production-loop.mjs",
    "test:i1:browser": "playwright test",
    "test:integration": "node -e \"console.error('[AR-R6] test:integration NOT CONFIGURED: no integration test infrastructure exists in this repo (baseline gap, see docs/baseline)'); process.exit(1)\"",
    "test:architecture": "node scripts/architecture/check-dependencies.mjs",
    "test:migrations:ledger": "node scripts/test/run-migration-ledger-contract.mjs",
    "test:baseline-smoke": "node scripts/test/run-baseline-data-smoke.mjs",
    "test:m2-rbac-auth": "node scripts/test/run-m2-rbac-auth.mjs",
    "auth:biz-init-super-admin": "node scripts/auth/biz-init-super-admin.mjs",
    "demo:seed": "node scripts/auth/biz-seed-demo-data.mjs",
    "release:integrity:report": "node scripts/release/check-release-integrity.mjs",
    "release:integrity:gate": "node scripts/release/check-release-integrity.mjs --gate",
    "release:integrity:checkpoint": "node scripts/release/check-release-integrity.mjs --checkpoint",
    "release:completeness": "node scripts/release/check-platform-completeness.mjs",
    "release:hosting-bundle": "node scripts/release/build-hosting-bundle.mjs",
    "test:hosting-bundle": "node scripts/test/check-hosting-bundle.mjs",
    "test:e2e": "playwright test",
    "governance:gates": "node scripts/release/check-governance-gates.mjs --gate && node scripts/test/check-governance-evidence.mjs --gate",
    "test:m3-contracts": "node scripts/test/run-m3-contracts.mjs",
    "test:m4-orders": "node scripts/test/run-m4-orders.mjs",
    "test:m5-offcost": "node scripts/test/run-m5-offcost.mjs",
    "test:m6-aggregates": "node scripts/test/run-m6-aggregates.mjs",
    "test:m7-views": "node scripts/test/m7-views.mjs",
    "test:m8-security": "node scripts/test/run-m8-security.mjs",
    "release:preflight": "node scripts/release/preflight.mjs",
    "test:m9-negative": "node scripts/test/run-m9-negative.mjs",
    "test:m10-negative": "node scripts/test/run-m10-negative.mjs",
    "test:m11-business": "node scripts/test/run-m11-business.mjs",
    "test:m12-interaction": "node scripts/test/run-m12-interaction.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "eslint": "^9",
    "typescript-eslint": "^8"
  }
}
